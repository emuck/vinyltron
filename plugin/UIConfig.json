{
    "page": {
        "label": "Vinyltron Settings"
    },
    "sections": [
        {
            "id": "section_display",
            "element": "section",
            "label": "Display — updates instantly",
            "icon": "fa-television",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "saveDisplay"
            },
            "saveButton": {
                "label": "Save",
                "data": ["brightness", "gamma", "progress_bar_height", "progress_bar_foreground", "progress_bar_background", "format_badge", "format_font", "badge_duration"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Display settings updated"
                }
            },
            "content": [
                {
                    "id": "brightness",
                    "element": "select",
                    "label": "Brightness",
                    "value": {},
                    "options": [
                        {"value": "10",  "label": "10%"},
                        {"value": "20",  "label": "20%"},
                        {"value": "30",  "label": "30%"},
                        {"value": "40",  "label": "40%"},
                        {"value": "50",  "label": "50%"},
                        {"value": "60",  "label": "60%"},
                        {"value": "70",  "label": "70%"},
                        {"value": "80",  "label": "80%"},
                        {"value": "90",  "label": "90%"},
                        {"value": "100", "label": "100%"}
                    ],
                    "doc": "LED panel brightness"
                },
                {
                    "id": "gamma",
                    "element": "select",
                    "label": "Gamma",
                    "value": {},
                    "options": [
                        {"value": "1.8", "label": "1.8 — Bright"},
                        {"value": "2.0", "label": "2.0"},
                        {"value": "2.2", "label": "2.2 — Default"},
                        {"value": "2.4", "label": "2.4 — Dark"}
                    ],
                    "doc": "Display gamma correction curve"
                },
                {
                    "id": "progress_bar_height",
                    "element": "input",
                    "label": "Progress Height",
                    "value": {},
                    "min": 0,
                    "max": 64,
                    "doc": "Height of the progress strip in pixels. Set to 0 to disable. Valid range: 0-64."
                },
                {
                    "id": "progress_bar_foreground",
                    "element": "select",
                    "label": "Progress Fill",
                    "value": {},
                    "options": [
                        {"value": "255,255,255", "label": "White"},
                        {"value": "255,160,0",   "label": "Amber"},
                        {"value": "0,220,80",    "label": "Green"},
                        {"value": "0,255,255",   "label": "Cyan"}
                    ],
                    "doc": "Filled portion color"
                },
                {
                    "id": "progress_bar_background",
                    "element": "select",
                    "label": "Progress Track",
                    "value": {},
                    "options": [
                        {"value": "",            "label": "Album Art"},
                        {"value": "0,0,0",       "label": "Black"},
                        {"value": "32,32,32",    "label": "Dim Gray"},
                        {"value": "0,32,32",     "label": "Deep Cyan"},
                        {"value": "32,20,0",     "label": "Deep Amber"}
                    ],
                    "doc": "Unfilled portion color"
                },
                {
                    "id": "format_badge",
                    "element": "switch",
                    "label": "Format Overlay",
                    "value": false,
                    "doc": "Show compact audio format text at the top of the display"
                },
                {
                    "id": "format_font",
                    "element": "select",
                    "label": "Format Font",
                    "value": {},
                    "options": [
                        {"value": "tom_thumb", "label": "Tom Thumb"},
                        {"value": "tiny5",     "label": "Tiny5"},
                        {"value": "spleen",    "label": "Spleen 5x8"}
                    ],
                    "doc": "Pixel font used for the compact format overlay"
                },
                {
                    "id": "badge_duration",
                    "element": "select",
                    "label": "Format Duration",
                    "value": {},
                    "options": [
                        {"value": "5",  "label": "5 seconds"},
                        {"value": "10", "label": "10 seconds"},
                        {"value": "15", "label": "15 seconds"},
                        {"value": "20", "label": "20 seconds"},
                        {"value": "30", "label": "30 seconds"}
                    ],
                    "doc": "How long the format badge remains visible after a new track starts"
                }
            ]
        },
        {
            "id": "section_idle",
            "element": "section",
            "label": "Idle Image — updates instantly",
            "icon": "fa-picture-o",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "saveIdle"
            },
            "saveButton": {
                "label": "Save",
                "data": ["fallback_mode", "fallback_image_folder", "fallback_selected_image"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Idle image settings updated"
                }
            },
            "content": [
                {
                    "id": "fallback_mode",
                    "element": "select",
                    "label": "Idle Mode",
                    "value": {},
                    "options": [
                        {"value": "single",        "label": "Built-in Idle Image"},
                        {"value": "selected",      "label": "Selected Folder Image"},
                        {"value": "random_folder", "label": "Random Folder Image"}
                    ],
                    "doc": "Controls which image is shown when playback is stopped"
                },
                {
                    "id": "fallback_image_folder",
                    "element": "input",
                    "label": "Idle Folder",
                    "value": "",
                    "doc": "Copy images into this folder via the Volumio network share or SCP"
                },
                {
                    "id": "fallback_selected_image",
                    "element": "select",
                    "label": "Idle Image",
                    "value": {},
                    "options": [
                        {"value": "", "label": "No image found"}
                    ],
                    "doc": "Image filename used when Idle Mode is Selected Folder Image"
                }
            ]
        },
        {
            "id": "section_hardware",
            "element": "section",
            "label": "Hardware — requires restart",
            "icon": "fa-refresh",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "saveHardware"
            },
            "saveButton": {
                "label": "Save & Restart",
                "data": ["rotation", "hardware_mapping", "limit_refresh_rate_hz"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Vinyltron restarting — display back in a few seconds"
                }
            },
            "content": [
                {
                    "id": "rotation",
                    "element": "select",
                    "label": "Rotation",
                    "value": {},
                    "options": [
                        {"value": "0",   "label": "0°"},
                        {"value": "90",  "label": "90°"},
                        {"value": "180", "label": "180°"},
                        {"value": "270", "label": "270°"}
                    ],
                    "doc": "Rotate to match panel mounting orientation"
                },
                {
                    "id": "hardware_mapping",
                    "element": "select",
                    "label": "Matrix Mapping",
                    "value": {},
                    "options": [
                        {"value": "adafruit-hat-pwm", "label": "Bonnet PWM"},
                        {"value": "adafruit-hat",     "label": "Bonnet"},
                        {"value": "regular",          "label": "Direct GPIO"}
                    ],
                    "doc": "GPIO mapping for the matrix adapter. Bonnet PWM requires the GPIO4-to-GPIO18 quality jumper."
                },
                {
                    "id": "limit_refresh_rate_hz",
                    "element": "input",
                    "label": "Refresh Limit (Hz)",
                    "value": "0",
                    "doc": "Caps the HUB75 scan refresh rate. 0 is uncapped. 90-140 Hz is a useful tuning range; 120 Hz reduced flicker on the test bonnet setup."
                }
            ]
        },
        {
            "id": "section_power",
            "element": "section",
            "label": "Power — updates instantly",
            "icon": "fa-power-off",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "toggleDisplay"
            },
            "saveButton": {
                "label": "Apply",
                "data": ["display_on"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Display updated"
                }
            },
            "content": [
                {
                    "id": "display_on",
                    "element": "switch",
                    "label": "Display On",
                    "value": true,
                    "doc": "Blank the panel without stopping the service. Art resumes instantly when re-enabled."
                }
            ]
        }
    ]
}
