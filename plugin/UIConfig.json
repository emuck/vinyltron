{
    "page": {
        "label": "Vinyltron Settings"
    },
    "sections": [
        {
            "id": "section_display",
            "element": "section",
            "label": "Display",
            "icon": "fa-television",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "saveConfig"
            },
            "saveButton": {
                "label": "Save",
                "data": ["brightness", "gamma", "rotation", "progress_bar", "format_badge"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Settings saved — Vinyltron restarting"
                }
            },
            "content": [
                {
                    "id": "brightness",
                    "element": "select",
                    "label": "Brightness",
                    "value": {},
                    "options": [
                        {"value": "10",  "label": "10%"},
                        {"value": "20",  "label": "20%"},
                        {"value": "30",  "label": "30%"},
                        {"value": "40",  "label": "40%"},
                        {"value": "50",  "label": "50%"},
                        {"value": "60",  "label": "60%"},
                        {"value": "70",  "label": "70%"},
                        {"value": "80",  "label": "80%"},
                        {"value": "90",  "label": "90%"},
                        {"value": "100", "label": "100%"}
                    ],
                    "doc": "LED panel brightness"
                },
                {
                    "id": "gamma",
                    "element": "select",
                    "label": "Gamma",
                    "value": {},
                    "options": [
                        {"value": "1.8", "label": "1.8 — Bright"},
                        {"value": "2.0", "label": "2.0"},
                        {"value": "2.2", "label": "2.2 — Default"},
                        {"value": "2.4", "label": "2.4 — Dark"}
                    ],
                    "doc": "Display gamma correction curve"
                },
                {
                    "id": "rotation",
                    "element": "select",
                    "label": "Rotation",
                    "value": {},
                    "options": [
                        {"value": "0",   "label": "0°"},
                        {"value": "90",  "label": "90°"},
                        {"value": "180", "label": "180°"},
                        {"value": "270", "label": "270°"}
                    ],
                    "doc": "Rotate to match panel mounting orientation. Requires restart."
                },
                {
                    "id": "progress_bar",
                    "element": "switch",
                    "label": "Progress Bar",
                    "value": true,
                    "doc": "Show playback progress strip at bottom of display (Phase 2)"
                },
                {
                    "id": "format_badge",
                    "element": "switch",
                    "label": "Format Badge",
                    "value": false,
                    "doc": "Show audio format icon in corner (Phase 2)"
                }
            ]
        },
        {
            "id": "section_power",
            "element": "section",
            "label": "Power",
            "icon": "fa-power-off",
            "onSave": {
                "type": "controller",
                "endpoint": "user_interface/vinyltron",
                "method": "toggleDisplay"
            },
            "saveButton": {
                "label": "Apply",
                "data": ["display_on"],
                "popup": {
                    "allowClose": true,
                    "type": "success",
                    "message": "Display updated"
                }
            },
            "content": [
                {
                    "id": "display_on",
                    "element": "switch",
                    "label": "Display On",
                    "value": true,
                    "doc": "Blank the panel without stopping the service. Art resumes instantly when re-enabled."
                }
            ]
        }
    ]
}
